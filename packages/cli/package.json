{
  "name": "@activefs/cli",
  "version": "0.1.1",
  "description": "CLI and TUI for connecting, browsing, searching, exporting, and optionally mounting ActiveFS remotes.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "activefs",
    "cli",
    "tui",
    "virtual-filesystem",
    "remote-data",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitparasher/activefs.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ankitparasher/activefs#readme",
  "bugs": {
    "url": "https://github.com/ankitparasher/activefs/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@activefs/config": "workspace:*",
    "@activefs/core": "workspace:*",
    "@activefs/local": "workspace:*",
    "@activefs/mcp": "workspace:*",
    "@activefs/mount": "workspace:*",
    "@activefs/source-http": "workspace:*",
    "@activefs/testing": "workspace:*",
    "blessed": "^0.1.81"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27"
  }
}
