{
  "name": "@activefs/source-http",
  "version": "0.1.1",
  "description": "HTTP Source API v1 client and server helpers for ActiveFS remotes.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "activefs",
    "source-api",
    "http",
    "sse"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitparasher/activefs.git",
    "directory": "packages/source-http"
  },
  "homepage": "https://github.com/ankitparasher/activefs#readme",
  "bugs": {
    "url": "https://github.com/ankitparasher/activefs/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js",
      "require": "./dist/fetch.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/fetch.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@activefs/core": "workspace:*"
  }
}
