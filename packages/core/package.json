{
  "name": "@activefs/core",
  "version": "0.1.1",
  "description": "Core ActiveFS contracts, router, errors, source capabilities, shared path/content helpers, and cache-aware runtime types.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "activefs",
    "filesystem",
    "virtual-filesystem",
    "source-api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitparasher/activefs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ankitparasher/activefs#readme",
  "bugs": {
    "url": "https://github.com/ankitparasher/activefs/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
