{
  "name": "@activefs/config",
  "version": "0.1.1",
  "description": "Unified ActiveFS state-root configuration, auth, and policy helpers.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "activefs",
    "config",
    "policy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankitparasher/activefs.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/ankitparasher/activefs#readme",
  "bugs": {
    "url": "https://github.com/ankitparasher/activefs/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@activefs/core": "workspace:*"
  }
}
